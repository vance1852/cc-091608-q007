{
  "name": "wearable-trial-custody",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "腕戴临床试验数据监管链平台：设备交接、上传校验、冲突隔离、校正替代、冻结修订与双人解盲",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "generate": "tsc && node dist/generate.js",
    "start": "npm run generate && node dist/main.js",
    "test": "tsc && node dist/generate.js && node --test \"dist/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "22",
    "typescript": "5.9.2"
  }
}
